# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs.
# Ne JAMAIS commit le fichier ".env" sur GitHub (ajoutez-le à .gitignore).

# Clé secrète Stripe — Dashboard Stripe > Developers > API keys
# Utilisez la clé "sk_test_..." pour tester, "sk_live_..." en production
STRIPE_SECRET_KEY=sk_test_votre_cle_ici

# Secret du webhook Stripe — généré quand vous créez le endpoint webhook
# Dashboard Stripe > Developers > Webhooks > votre endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_ici

# URL de votre site (celui qui contient forfaits.html)
# Utilisée pour les redirections success_url / cancel_url
SITE_URL=https://www.massokin.com

# Port du serveur (Render/Railway fournissent leur propre PORT automatiquement)
PORT=3000

# Clé API Resend (https://resend.com) — pour l'envoi des certificats par email
# Dashboard Resend > API Keys
RESEND_API_KEY=re_votre_cle_ici

# Adresse d'envoi — DOIT appartenir à un domaine vérifié sur Resend
# (voir README.md, section "Configurer Resend")
EMAIL_FROM=Massokin <cadeaux@massokin.com>

# Adresse où les réponses des clients doivent atterrir
EMAIL_REPLY_TO=contact@massokin.com

# Chemin du fichier de base de données SQLite (les certificats vendus).
# Par défaut : ./data/massokin.db — voir README.md section 7 pour le
# point important sur la persistance du disque en production.
DB_PATH=./data/massokin.db

# Clé secrète pour protéger les routes admin (vérifier/valider un certificat).
# Génère une longue chaîne aléatoire, ex: openssl rand -hex 32
ADMIN_KEY=change-moi-avec-une-longue-cle-aleatoire
